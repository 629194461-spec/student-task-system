NODE_ENV=production
PORT=4173
HOST=0.0.0.0
APP_TIMEZONE=Asia/Shanghai
STORAGE_DRIVER=cos
COS_BUCKET=examplebucket-1250000000
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
# 可填写已绑定 COS 的 CDN/自定义域名；留空时使用 COS 默认访问域名。
COS_PUBLIC_BASE_URL=
COS_PATH_PREFIX=learning-planet
# 仅本地/测试环境使用；生产环境保持注释，继续使用 Docker 数据卷中的 /app/data。
# DATA_DIR=/absolute/path/to/isolated-test-data
